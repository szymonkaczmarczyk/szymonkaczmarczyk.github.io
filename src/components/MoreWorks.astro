---
import ProjectVideo from './ProjectVideo.astro';
import { chapterSlugs, homeAnchorFor, localizeProject, moreProjects, projectHref, titleTransitionNameFor, transitionNameFor } from '../data/projekty';
import { siteCopy } from '../data/strona';
import { sectionIds, type Locale } from '../data/jezyki';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const workCopy = siteCopy[locale].work;
const ids = sectionIds[locale];
const titleId = `${ids.more}-title`;
const lastIndex = moreProjects.length - 1;
const isWide = (index: number) => index % 3 === 0 || (index === lastIndex && index % 3 === 1);
const firstNumber = chapterSlugs.length + 1;

const works = moreProjects.map((project, index) => ({
  project: localizeProject(project, locale),
  wide: isWide(index),
  anchor: homeAnchorFor(project.slug, locale),
  number: String(firstNumber + index).padStart(2, '0'),
}));
---

<section id={ids.more} class="shell more" aria-labelledby={titleId}>
  <div class="more__head">
    <h2 id={titleId} class="more__title">{workCopy.moreHeading}</h2>
    <p class="small more__count">{workCopy.projectCount(works.length)}</p>
  </div>
  <ul class="more__grid">
    {
      works.map((work) => (
        <li id={work.anchor} class:list={['work', { 'work--wide': work.wide }]}>
          <div class="work__media reveal-frame" style={`view-transition-name: ${transitionNameFor(work.project.slug)}`}>
            <ProjectVideo class="work__frame" slug={work.project.slug} label={workCopy.recordingLabel(work.project.name)} />
          </div>
          <div class="work__caption">
            <span class="small work__number" aria-hidden="true">{work.number}</span>
            <h3 class="work__name">
              <a class="work__link" href={projectHref(work.project.slug, locale)} style={`view-transition-name: ${titleTransitionNameFor(work.project.slug)}`}>
                {work.project.name}
              </a>
            </h3>
            <p class="hand work__kind">{work.project.kind}</p>
            {work.wide && <p class="work__tagline">{work.project.tagline}</p>}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .more {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-gap) 0;
  }

  .more__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thin) solid var(--color-line);
  }

  .more__count {
    color: var(--color-ink-muted);
  }

  .more__grid {
    display: grid;
    gap: var(--space-8) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .work {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    scroll-margin-top: var(--space-4);
  }

  .work__media {
    --reveal-radius: var(--radius-media);
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-ink);
  }

  .work__media :global(.work__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .work__caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--space-2);
    row-gap: var(--space-half);
  }

  .work__number {
    grid-column: 2;
    grid-row: 1;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-caps);
  }

  .work__name {
    grid-column: 1;
    grid-row: 1;
    font-size: var(--text-h3);
  }

  .work__kind {
    grid-column: 1 / -1;
    color: var(--color-accent);
  }

  .work__tagline {
    grid-column: 1 / -1;
    margin-top: var(--space-1);
    color: var(--color-ink-muted);
    letter-spacing: var(--tracking-body);
  }

  .work__link {
    display: inline-block;
    text-decoration: none;
  }

  .work__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .work__link:focus-visible {
    outline: none;
  }

  .work:has(.work__link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--space-1);
    border-radius: var(--radius-media);
  }

  @media (hover: hover) {
    .work:hover .work__link {
      text-decoration: underline;
      text-decoration-thickness: var(--border-thin);
      text-underline-offset: 0.12em;
    }
  }

  @media (hover: none) {
    .work:active .work__link {
      text-decoration: underline;
      text-decoration-thickness: var(--border-thin);
      text-underline-offset: 0.12em;
    }
  }

  @media (min-width: 768px) {
    .more__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .work--wide {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: var(--space-8);
      padding-bottom: var(--space-8);
      border-bottom: var(--border-thin) solid var(--color-line);
    }

    .work--wide .work__caption {
      grid-template-columns: minmax(0, 1fr);
    }

    .work--wide .work__number {
      grid-column: 1;
      grid-row: auto;
      order: -1;
    }

    .work--wide .work__name {
      grid-row: auto;
      font-size: var(--text-h2);
    }

    .work--wide .work__tagline {
      max-width: 40ch;
    }
  }
</style>
