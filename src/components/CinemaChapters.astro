---
import ProjectVideo from './ProjectVideo.astro';
import { chapterProjects, homeAnchorFor, projectHref, titleTransitionNameFor, transitionNameFor } from '../data/projekty';

const chapterTones = ['ink', 'accent'] as const;
const dividerPath = 'M0 22C140 8 260 34 420 20S700 6 860 22S1160 36 1300 18S1400 14 1440 20';
const wavePath = 'M0 96V52C120 30 220 70 360 48S600 18 760 44S1040 78 1200 46S1380 30 1440 40V96Z';
const waveSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 96' preserveAspectRatio='none'><path d='${wavePath}'/></svg>`;
const waveMaskStyle = `--wave-mask: url("data:image/svg+xml,${encodeURIComponent(waveSvg)}")`;

const chapters = chapterProjects.map((project, index) => ({
  project,
  number: index + 1,
  anchor: homeAnchorFor(project.slug),
  tone: chapterTones[index % chapterTones.length],
}));
---

<section id="prace" class="cinema" data-cinema data-tone={chapters[0].tone} aria-labelledby="prace-title">
  <div class="cinema__wave grain" style={waveMaskStyle} aria-hidden="true"></div>

  <div class="cinema__body grain">
    <h2 id="prace-title" class="visually-hidden">Prace</h2>

    <nav class="cinema__progress" aria-label="rozdziały">
      <ol class="shell cinema__progress-list">
        {
          chapters.map((chapter) => (
            <li>
              <a class="cinema__progress-link" href={`#${chapter.anchor}`} data-chapter-link>
                <span class="cinema__progress-track" aria-hidden="true">
                  <span class="cinema__progress-fill" />
                </span>
                <span class="visually-hidden">
                  rozdział {chapter.number}: {chapter.project.name}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      chapters.map((chapter) => (
        <>
        {chapter.number > 1 && (
          <div class="chapter-divider" aria-hidden="true">
            <svg class="chapter-divider__line" viewBox="0 0 1440 40" preserveAspectRatio="none" focusable="false">
              <path class="reveal-line" d={dividerPath} pathLength="1" />
            </svg>
          </div>
        )}
        <article id={chapter.anchor} class="shell chapter" data-chapter data-tone={chapter.tone} aria-labelledby={`${chapter.anchor}-nazwa`}>
          <div class="chapter__caption">
            <h3 id={`${chapter.anchor}-nazwa`} class="chapter__name" style={`view-transition-name: ${titleTransitionNameFor(chapter.project.slug)}`}>
              {chapter.project.name}
            </h3>
            <p class="chapter__tagline">{chapter.project.tagline}</p>
            <a class="button button--paper" href={projectHref(chapter.project.slug)}>
              Zobacz projekt<span class="visually-hidden"> {chapter.project.name}</span>
              <span class="button__arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <figure class="chapter__figure">
            <div class="chapter__media reveal-frame" style={`view-transition-name: ${transitionNameFor(chapter.project.slug)}`}>
              <ProjectVideo class="chapter__frame" slug={chapter.project.slug} label={`nagranie projektu ${chapter.project.name}`} />
            </div>
            <figcaption class="small chapter__stack">{chapter.project.stack.join(' · ')}</figcaption>
          </figure>
        </article>
        </>
      ))
    }
  </div>

  <div class="cinema__wave cinema__wave--closing grain" style={waveMaskStyle} aria-hidden="true"></div>
</section>

<style>
  .cinema {
    --cinema-tone: var(--color-ink);
    --tone-transition: var(--duration-long) var(--ease-calm);
    --focus-ring: 3px solid var(--color-sun);
    color: var(--color-paper);
  }

  .cinema[data-tone='accent'] {
    --cinema-tone: var(--color-accent);
  }

  .cinema__wave {
    display: block;
    width: 100%;
    height: clamp(32px, 6vw, 88px);
    margin-bottom: -1px;
    background-color: var(--cinema-tone);
    mask-image: var(--wave-mask);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    transition: background-color var(--tone-transition);
  }

  .cinema__wave--closing {
    margin-top: -1px;
    margin-bottom: 0;
    transform: scaleY(-1);
  }

  .cinema__body {
    padding-bottom: var(--space-8);
    background-color: var(--cinema-tone);
    transition: background-color var(--tone-transition);
  }

  .cinema__progress {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--cinema-tone);
    background-image: var(--grain-texture);
    transition: background-color var(--tone-transition);
  }

  .cinema__progress-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: var(--space-1);
    padding-block: 0;
    list-style: none;
  }

  .cinema__progress-link {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  .cinema__progress-track {
    position: relative;
    width: 100%;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-paper) 28%, transparent);
  }

  .cinema__progress-fill {
    position: absolute;
    inset: 0;
    background: var(--color-sun);
    transform: scaleX(var(--chapter-progress, 0));
    transform-origin: left center;
  }

  .chapter {
    position: relative;
    display: grid;
    gap: var(--space-4);
    scroll-margin-top: var(--touch-target);
  }

  .chapter-divider {
    padding: var(--space-6) var(--gutter);
  }

  .chapter-divider__line {
    display: block;
    width: 100%;
    height: 40px;
    overflow: visible;
    fill: none;
    stroke: color-mix(in srgb, var(--color-paper) 45%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .chapter__figure {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .chapter__media {
    --reveal-radius: var(--radius-media);
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-ink);
    box-shadow: 0 0 0 var(--border-thin) color-mix(in srgb, var(--color-paper) 14%, transparent);
  }

  .chapter__media :global(.chapter__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .chapter__stack {
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
  }

  .chapter__caption {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .chapter__name {
    font-size: var(--text-h2);
  }

  .chapter__tagline {
    max-width: 34ch;
    font-size: var(--text-body-large);
    letter-spacing: var(--tracking-body);
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
  }

  .chapter__caption .button {
    margin-top: var(--space-2);
  }

  @media (max-width: 1023px) {
    .chapter__figure {
      order: -1;
    }

    .chapter__caption {
      padding-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .chapter {
      grid-template-columns: 4fr 8fr;
      align-items: center;
      gap: var(--space-8);
      padding-block: var(--space-4);
    }
  }
</style>

<script>
  const cinema = document.querySelector<HTMLElement>('[data-cinema]');
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const progressLinks = [...document.querySelectorAll<HTMLElement>('[data-chapter-link]')];

  if (cinema && chapters.length === progressLinks.length) {
    let frameRequested = false;
    let activeIndex = -1;

    const chapterProgress = (chapter: HTMLElement) => {
      const bounds = chapter.getBoundingClientRect();
      const viewportMiddle = window.innerHeight / 2;
      return Math.min(1, Math.max(0, (viewportMiddle - bounds.top) / bounds.height));
    };

    const markActiveChapter = (index: number) => {
      if (index === activeIndex) return;
      activeIndex = index;
      cinema.dataset.tone = chapters[index].dataset.tone;
      progressLinks.forEach((link, linkIndex) => {
        if (linkIndex === index) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
    };

    const updateProgress = () => {
      frameRequested = false;
      let reachedIndex = 0;
      chapters.forEach((chapter, index) => {
        const progress = chapterProgress(chapter);
        progressLinks[index].style.setProperty('--chapter-progress', progress.toFixed(3));
        if (progress > 0) reachedIndex = index;
      });
      markActiveChapter(reachedIndex);
    };

    const requestUpdate = () => {
      if (frameRequested) return;
      frameRequested = true;
      requestAnimationFrame(updateProgress);
    };

    const cinemaVisibility = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', requestUpdate, { passive: true });
        requestUpdate();
      } else {
        window.removeEventListener('scroll', requestUpdate);
        window.removeEventListener('resize', requestUpdate);
      }
    });

    cinemaVisibility.observe(cinema);
  }
</script>
