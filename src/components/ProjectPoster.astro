---
type Props = {
  slug: string;
  alt: string;
  class?: string;
};

const { slug, alt, class: className } = Astro.props;
const posterBase = `/video/${slug}`;
---

<picture class:list={['project-poster', className]}>
  <source srcset={`${posterBase}-pion.webp`} media="(max-width: 767px)" type="image/webp" />
  <source srcset={`${posterBase}.webp`} type="image/webp" />
  <img src={`${posterBase}.jpg`} alt={alt} loading="lazy" decoding="async" />
</picture>

<style>
  .project-poster,
  .project-poster img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-poster img {
    object-fit: cover;
  }
</style>
