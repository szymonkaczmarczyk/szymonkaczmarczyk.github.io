---
import ProjectVideo from './ProjectVideo.astro';
import { deskLaptopProject as laptopProject, deskPhoneProject as phoneProject } from '../data/projekty';
---

<div class="desk">
  <svg class="desk__drawing" viewBox="0 0 800 560" aria-hidden="true" focusable="false">
    <circle class="desk__sun" cx="150" cy="118" r="56" />
    <g class="desk__cloud">
      <rect x="160" y="146" width="140" height="32" rx="16" />
      <circle cx="198" cy="146" r="26" />
      <circle cx="238" cy="128" r="34" />
      <circle cx="276" cy="150" r="22" />
    </g>

    <line class="desk__floor" x1="0" y1="551" x2="800" y2="551" />
    <rect class="desk__leg" x="84" y="446" width="18" height="104" />
    <rect class="desk__leg" x="698" y="446" width="18" height="104" />
    <rect class="desk__apron" x="60" y="420" width="680" height="28" />
    <rect class="desk__top" x="40" y="400" width="720" height="22" rx="4" />

    <path class="desk__steam" d="M114 330c-9-10 9-18 0-30" />
    <path class="desk__steam" d="M136 330c-9-10 9-18 0-30" />
    <path class="desk__mug-handle" d="M156 358a15 15 0 0 1 0 30" />
    <rect class="desk__mug" x="96" y="342" width="60" height="60" rx="10" />

    <rect class="desk__device" x="214" y="160" width="372" height="240" rx="14" />
    <path class="desk__device" d="M192 398H608L598 410H202Z" />
    <rect class="desk__device" x="618" y="276" width="68" height="126" rx="12" />

    <path class="desk__leaf--sage" d="M726 354c-32-18-46-52-42-76 24 14 40 42 42 76Z" />
    <path class="desk__leaf" d="M728 354c-18-52-10-90 4-116 14 26 18 64-4 116Z" />
    <path class="desk__leaf" d="M730 354c30-16 44-46 42-70-24 12-38 38-42 70Z" />
    <path class="desk__pot" d="M700 352H756L749 402H707Z" />
  </svg>

  <ProjectVideo
    class="desk__laptop-screen"
    slug={laptopProject.slug}
    label={`nagranie strony ${laptopProject.name} na ekranie laptopa`}
    orientation="landscape"
    priority
    compact
  />

  <picture class="desk__phone-screen">
    <source srcset={`/video/${phoneProject.slug}-pion.webp`} type="image/webp" />
    <img src={`/video/${phoneProject.slug}-pion.jpg`} alt={`ekran telefonu ze stroną ${phoneProject.name}, ${phoneProject.kind}`} width="720" height="1280" decoding="async" />
  </picture>
</div>

<style>
  .desk {
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 560;
  }

  .desk__drawing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .desk__sun {
    fill: var(--color-sun);
  }

  .desk__cloud {
    fill: var(--color-cloud);
  }

  .desk__floor {
    stroke: var(--color-desk-edge);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .desk__top {
    fill: var(--color-desk);
    stroke: var(--color-desk-edge);
    stroke-width: 3;
  }

  .desk__apron,
  .desk__leg {
    fill: var(--color-desk-edge);
  }

  .desk__mug {
    fill: var(--color-sage);
  }

  .desk__mug-handle {
    fill: none;
    stroke: var(--color-sage);
    stroke-width: 8;
  }

  .desk__steam {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .desk__device {
    fill: var(--color-ink);
  }

  .desk__pot {
    fill: var(--color-pot);
  }

  .desk__leaf {
    fill: var(--color-leaf);
  }

  .desk__leaf--sage {
    fill: var(--color-sage);
  }

  .desk :global(.desk__laptop-screen) {
    position: absolute;
    left: 29%;
    top: 31.4286%;
    width: 42%;
    height: 37.5%;
    border-radius: 4px;
  }

  .desk__phone-screen {
    position: absolute;
    left: 78%;
    top: 51.0714%;
    width: 7%;
    height: 17.8571%;
    overflow: hidden;
    border-radius: 6px;
  }

  .desk__phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
