---
import ProjectVideo from './ProjectVideo.astro';
import { deskLaptopProject, deskPhoneProject, localizeProject } from '../data/projekty';
import { siteCopy } from '../data/strona';
import type { Locale } from '../data/jezyki';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const startCopy = siteCopy[locale].start;
const laptopProject = localizeProject(deskLaptopProject, locale);
const phoneProject = localizeProject(deskPhoneProject, locale);
---

<div class="desk">
  <svg class="desk__drawing" viewBox="0 0 800 560" aria-hidden="true" focusable="false">
    <g class="desk__sun">
      <circle pathLength="1" cx="118" cy="92" r="30" />
      <path pathLength="1" d="M118 44V32M118 152v-12M70 92H58M178 92h-12M84 58l-8-8M160 134l-8-8M84 126l-8 8M160 50l-8 8" />
    </g>
    <path pathLength="1" class="desk__line desk__line--fine" d="M630 134c-4-26 30-34 42-16 8-20 44-16 44 8 18-2 26 22 8 30h-90c-18 0-20-20-4-22Z" />

    <rect pathLength="1" class="desk__line" x="188" y="136" width="400" height="262" rx="12" />
    <path pathLength="1" class="desk__line" d="M162 398H614v3q0 5-6 5H168q-6 0-6-5Z" />
    <path pathLength="1" class="desk__line desk__line--fine" d="M364 399q0 3 5 3h38q5 0 5-3" />

    <rect pathLength="1" class="desk__line" x="624" y="244" width="80" height="160" rx="18" />
    <path pathLength="1" class="desk__line desk__line--fine" d="M707 284v24M621 276v12M621 296v18" />

    <path pathLength="1" class="desk__line" d="M40 330v54q0 22 22 22h28q22 0 22-22v-54Z" />
    <path pathLength="1" class="desk__line" d="M112 344q26 0 26 18t-26 18" />
    <path pathLength="1" class="desk__line desk__line--fine" d="M64 314q-8-12 0-24t0-24M88 314q-8-12 0-24t0-24" />

    <path pathLength="1" class="desk__line" d="M714 340 720 406h42l6-66Z" />
    <path pathLength="1" class="desk__leaf" d="M741 340c-18-40-22-76-8-116 20 40 22 78 8 116ZM743 340c18-30 34-46 48-50-4 28-20 46-48 50ZM739 340c-10-18-18-28-26-32 2 20 12 30 26 32Z" />

    <path pathLength="1" class="desk__line" d="M20 408h760M20 422h760M20 408v14M780 408v14" />
    <path pathLength="1" class="desk__line" d="M70 422 62 548M730 422l8 126M94 422l-4 90M706 422l4 90" />
    <path pathLength="1" class="desk__line desk__line--floor" d="M0 550h800" />
  </svg>

  <ProjectVideo
    class="desk__laptop-screen"
    slug={laptopProject.slug}
    label={startCopy.laptopLabel(laptopProject.name)}
    priority
  />
  <span class="desk__notch" aria-hidden="true"></span>

  <div class="desk__phone-screen">
    <ProjectVideo
      class="desk__phone-video"
      slug={phoneProject.slug}
      orientation="pion"
      label={startCopy.phoneLabel(phoneProject.name, phoneProject.kind)}
    />
    <span class="desk__island" aria-hidden="true"></span>
  </div>
</div>

<style>
  .desk {
    --desk-stroke: 2.6;
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 560;
  }

  .desk__drawing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .desk__drawing path,
  .desk__drawing rect,
  .desk__drawing circle {
    fill: none;
    stroke-width: var(--desk-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }

  .desk__line {
    stroke: var(--color-ink);
  }

  .desk__line--fine {
    stroke-width: calc(var(--desk-stroke) * 0.75);
  }

  .desk__line--floor {
    stroke: var(--color-line);
  }

  .desk__sun {
    stroke: var(--color-sun);
  }

  .desk__sun circle,
  .desk__sun path {
    stroke-width: calc(var(--desk-stroke) * 1.2);
  }

  .desk__leaf {
    stroke: var(--color-accent);
  }

  .desk :global(.desk__laptop-screen) {
    position: absolute;
    left: 24.25%;
    top: 25.3571%;
    width: 48.5%;
    height: 44.6429%;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .desk__notch {
    position: absolute;
    left: 48.5%;
    top: 25.3571%;
    width: 4.5%;
    height: 1.6%;
    border-radius: 0 0 var(--radius) var(--radius);
    background-color: var(--color-ink);
    translate: -50% 0;
  }

  .desk__phone-screen {
    position: absolute;
    left: 78.625%;
    top: 44.4643%;
    width: 8.75%;
    height: 26.7857%;
    overflow: hidden;
    border-radius: 18% / 8.4%;
    background-color: var(--color-ink);
    container-type: inline-size;
  }

  .desk__phone-screen :global(.desk__phone-video) {
    position: absolute;
    inset: 0;
  }

  .desk__island {
    position: absolute;
    top: 4cqi;
    left: 50%;
    width: 34cqi;
    height: 10cqi;
    border-radius: var(--radius-pill);
    background-color: black;
    translate: -50% 0;
  }

  @media (min-width: 768px) {
    .desk {
      --desk-stroke: 2;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .desk__drawing path,
    .desk__drawing rect,
    .desk__drawing circle {
      animation: desk-draw 1400ms var(--ease-calm) 150ms both;
    }

    .desk__sun circle,
    .desk__sun path,
    .desk__leaf {
      animation-delay: 650ms;
    }

    .desk :global(.desk__laptop-screen),
    .desk__notch,
    .desk__phone-screen {
      animation: screen-on var(--duration-medium) var(--ease-calm) 1100ms both;
    }
  }

  @keyframes desk-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes screen-on {
    from {
      opacity: 0;
      filter: brightness(1.8);
    }
  }
</style>
