---
import { aboutPhoto, owner, siteCopy } from '../data/strona';
import { sectionIds, type Locale } from '../data/jezyki';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const aboutCopy = siteCopy[locale].about;
const ids = sectionIds[locale];
const titleId = `${ids.about}-title`;

const photoSizes = '(min-width: 768px) 40vw, 100vw';
---

<section id={ids.about} class="shell about" aria-labelledby={titleId}>
  <picture class="about__photo">
    <source srcset={`${aboutPhoto}-720.webp 720w, ${aboutPhoto}-1080.webp 1080w`} sizes={photoSizes} type="image/webp" />
    <img src={`${aboutPhoto}-1080.jpg`} alt={aboutCopy.photoAlt} width="1080" height="1440" loading="lazy" decoding="async" />
  </picture>

  <div class="about__copy">
    <p class="hand about__note">{aboutCopy.note}</p>
    <h2 id={titleId}>{aboutCopy.heading}</h2>
    <p class="about__principle">{aboutCopy.principle}</p>
    <p class="lead about__text">{aboutCopy.text}</p>
    <p class="signature about__signature" aria-hidden="true">{owner.name}</p>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-gap) 0;
    scroll-margin-top: var(--space-4);
  }

  .about__photo {
    display: block;
    width: 100%;
  }

  .about__photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  .about__copy {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    container-type: inline-size;
  }

  .about__note {
    color: var(--color-accent);
    margin-bottom: calc(var(--space-2) * -1);
  }

  .about__principle {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
    font-size: var(--text-h3);
    line-height: 1.3;
    letter-spacing: -0.03em;
  }

  .about__text {
    color: var(--color-ink-muted);
    max-width: 50ch;
  }

  .about__signature {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-8);
      align-items: start;
    }

    .about__copy {
      position: sticky;
      top: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .about {
      column-gap: var(--space-12);
    }
  }
</style>
