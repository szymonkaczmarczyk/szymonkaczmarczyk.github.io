---
import { contactCopy, legalPages, owner } from '../data/strona';

const profiles = [
  { href: owner.github, label: 'GitHub' },
  { href: owner.linkedin, label: 'LinkedIn' },
];
---

<section id="kontakt" class="shell contact" aria-labelledby="kontakt-title">
  <p class="hand contact__note">kontakt</p>
  <h2 id="kontakt-title" class="contact__title">{contactCopy.heading}</h2>
  <a class="contact__email" href={`mailto:${owner.email}`}>{owner.email}</a>

  <div class="contact__row">
    <p class="lead contact__text">{contactCopy.text}</p>
    <ul class="contact__actions">
      <li>
        <a class="button" href={`mailto:${owner.email}`}>
          {contactCopy.actionLabel}
          <span class="button__arrow" aria-hidden="true">→</span>
        </a>
      </li>
      {
        profiles.map((profile) => (
          <li>
            <a class="button button--quiet" href={profile.href} rel="noopener noreferrer">
              {profile.label}
              <span class="button__arrow button__arrow--external" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="small contact__privacy">
    {contactCopy.privacyNote} {contactCopy.privacyLinkLead} <a href={legalPages.privacy.href}>{contactCopy.privacyLinkLabel}</a>.
  </p>
</section>

<style>
  .contact {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block: var(--section-gap) 0;
    scroll-margin-top: var(--space-4);
  }

  .contact__note {
    color: var(--color-accent);
  }

  .contact__title {
    max-width: 22ch;
  }

  .contact__email {
    margin-top: var(--space-3);
    font-size: clamp(24px, 5.6vw, 80px);
    font-weight: var(--weight-heading);
    line-height: 1.1;
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    text-decoration-color: var(--color-accent);
    transition: color var(--duration-short) var(--ease-calm);
  }

  .contact__email:hover {
    color: var(--color-accent);
  }

  .contact__row {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .contact__text {
    color: var(--color-ink-muted);
    max-width: 40ch;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .contact__privacy {
    color: var(--color-ink-muted);
  }

  .contact__privacy a {
    color: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .contact__row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
</style>
