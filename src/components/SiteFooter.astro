---
import { owner } from '../data/strona';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="small">{owner.name}, {currentYear}</p>
    <ul class="site-footer__links small">
      <li><a href="/polityka-prywatnosci/">polityka prywatności</a></li>
      <li><a href="/regulamin/">regulamin</a></li>
      <li><a href={owner.github} rel="noopener noreferrer">github</a></li>
      <li><a href={owner.linkedin} rel="noopener noreferrer">linkedin</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-thin) solid var(--color-line);
    margin-top: var(--section-gap);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
