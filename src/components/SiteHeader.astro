---
import { navigation, owner } from '../data/strona';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__name" href="/">{owner.name}</a>
    <nav aria-label="główna">
      <ul class="site-header__links">
        {
          navigation.map((item) => (
            <li>
              <a class="link-draw" href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background-color: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-height);
  }

  .site-header__name {
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__links {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-1);
    --link-inset: var(--space-1);
  }

  @media (max-width: 479px) {
    .site-header__name {
      font-size: var(--text-small);
    }

    .site-header__links {
      gap: 0;
    }

    .site-header__links a {
      font-size: var(--text-small);
    }
  }

  @media (max-width: 359px) {
    .site-header__links a {
      padding-inline: var(--space-half);
      --link-inset: var(--space-half);
    }
  }
</style>
