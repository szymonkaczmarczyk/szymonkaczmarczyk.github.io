---
import { owner, siteCopy } from '../data/strona';
import { homePaths, localeMeta, otherLocale, type Locale, type LocalizedPath } from '../data/jezyki';

type Props = {
  locale: Locale;
  alternates?: LocalizedPath;
};

const { locale, alternates = homePaths } = Astro.props;
const copy = siteCopy[locale];
const switchLocale = otherLocale(locale);
const switchMeta = localeMeta[switchLocale];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__name" href={homePaths[locale]}>{owner.name}</a>
    <nav class="site-header__nav" aria-label={copy.layout.mainNavigation}>
      <ul class="site-header__links">
        {
          copy.navigation.map((item) => (
            <li>
              <a class="link-draw" href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="site-header__language" href={alternates[switchLocale]} hreflang={switchMeta.htmlLang} lang={switchMeta.htmlLang}>
      {switchMeta.switchLabel}<span class="visually-hidden"> - {switchMeta.switchName}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background-color: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--header-height);
  }

  .site-header__name {
    margin-inline-end: auto;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__links {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-1);
    --link-inset: var(--space-1);
  }

  .site-header__language {
    display: inline-grid;
    place-items: center;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    border-left: 1px solid var(--color-line);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color var(--duration-short) var(--ease-calm);
  }

  .site-header__language:hover {
    color: var(--color-accent);
  }

  @media (max-width: 479px) {
    .site-header__name {
      font-size: var(--text-small);
    }

    .site-header__links {
      gap: 0;
    }

    .site-header__links a {
      font-size: var(--text-small);
    }

    .site-header__language {
      display: none;
    }
  }

  @media (max-width: 359px) {
    .site-header__links a {
      padding-inline: var(--space-half);
      --link-inset: var(--space-half);
    }
  }
</style>
