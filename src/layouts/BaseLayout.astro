---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteCopy } from '../data/strona';
import { localeMeta, locales, sectionIds, type Locale, type LocalizedPath } from '../data/jezyki';

type Props = {
  locale: Locale;
  alternates?: LocalizedPath;
  title?: string;
  description?: string;
  ogImage?: string;
  indexable?: boolean;
  preloadSerif?: boolean;
};

const { locale, alternates, title = siteCopy[locale].meta.title, description = siteCopy[locale].meta.description, ogImage = '/og.jpg', indexable = true, preloadSerif = false } = Astro.props;
const copy = siteCopy[locale];
const ids = sectionIds[locale];
const alternateLinks = indexable && alternates ? locales.map((alternateLocale) => ({ hreflang: localeMeta[alternateLocale].htmlLang, href: new URL(alternates[alternateLocale], Astro.site) })) : [];
const defaultAlternate = indexable && alternates ? new URL(alternates.pl, Astro.site) : undefined;
const otherOgLocales = locales.filter((candidate) => candidate !== locale).map((candidate) => localeMeta[candidate].ogLocale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4eee3" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex" />}
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {preloadSerif && <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />}
    {preloadSerif && <link rel="preload" href="/fonts/instrument-serif-latin-ext-400-italic.woff2" as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {otherOgLocales.map((ogLocale) => <meta property="og:locale:alternate" content={ogLocale} />)}
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="safe-top" aria-hidden="true"></div>
    <a class="skip-link" href={`#${ids.content}`}>{copy.layout.skipLink}</a>
    <SiteHeader locale={locale} alternates={alternates} />
    <main id={ids.content}>
      <slot />
    </main>
    <SiteFooter locale={locale} alternates={alternates} />
    <script>
      const dropHashAfterJump = () => {
        if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
      };
      window.addEventListener('hashchange', dropHashAfterJump);

      const scrollKey = `pozycja:${location.pathname}`;
      const readSavedScroll = () => {
        try {
          return sessionStorage.getItem(scrollKey);
        } catch {
          return null;
        }
      };
      window.addEventListener('pagehide', () => {
        try {
          sessionStorage.setItem(scrollKey, String(Math.round(window.scrollY)));
        } catch {}
      });

      history.scrollRestoration = 'manual';
      const [navigation] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
      const returnsToPage = navigation?.type === 'reload' || navigation?.type === 'back_forward';
      const savedScroll = returnsToPage ? readSavedScroll() : null;
      const targetScroll = savedScroll === null ? null : Number(savedScroll);

      if (targetScroll !== null) {
        const userTakesOver = ['wheel', 'touchstart', 'keydown', 'pointerdown'];
        const restoreScroll = () => window.scrollTo({ top: targetScroll, behavior: 'instant' });
        const keepRestoring = new ResizeObserver(restoreScroll);
        const stopRestoring = () => {
          keepRestoring.disconnect();
          userTakesOver.forEach((eventName) => window.removeEventListener(eventName, stopRestoring));
        };
        userTakesOver.forEach((eventName) => window.addEventListener(eventName, stopRestoring, { passive: true }));
        keepRestoring.observe(document.documentElement);
        restoreScroll();
        window.addEventListener('load', () => {
          restoreScroll();
          window.setTimeout(stopRestoring, 1500);
        }, { once: true });
      }

      if (document.readyState === 'complete') dropHashAfterJump();
      else window.addEventListener('load', dropHashAfterJump, { once: true });
    </script>
  </body>
</html>
