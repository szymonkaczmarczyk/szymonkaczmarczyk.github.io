---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVideo from '../../components/ProjectVideo.astro';
import ProjectPoster from '../../components/ProjectPoster.astro';
import { chapterSlugs, homeAnchorFor, nextProjectAfter, projectHref, projects, transitionNameFor, type Project } from '../../data/projekty';
import { formatClock, videoSeconds } from '../../lib/videoDuration';
import { owner } from '../../data/strona';

export const getStaticPaths = () => projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));

type Props = { project: Project };

const { project } = Astro.props;
const nextProject = nextProjectAfter(project.slug);
const backHref = `/#${homeAnchorFor(project.slug)}`;
const pageTitle = `${project.name} - ${project.kind} - ${owner.name}`;
const siteHost = project.url ? new URL(project.url).host : undefined;
const chapterIndex = chapterSlugs.indexOf(project.slug);
const seconds = project.media === 'video' ? videoSeconds(project.slug) : undefined;
const mediaNote = seconds === undefined ? 'zrzut ekranu' : `nagranie ${formatClock(seconds)}`;
const introNote = chapterIndex >= 0 ? `rozdział ${chapterIndex + 1} z ${chapterSlugs.length}` : mediaNote;
---

<BaseLayout title={pageTitle} description={project.tagline}>
  <article class="project" aria-labelledby="projekt-nazwa">
    <header class="shell project__intro">
      <a class="project__back" href={backHref}>
        <span class="project__back-arrow" aria-hidden="true">←</span>
        wszystkie prace
      </a>
      <p class="hand project__note">{introNote}</p>
      <h1 id="projekt-nazwa" class="project__name">{project.name}</h1>
      <p class="lead project__tagline">{project.tagline}</p>
    </header>

    <div class="project__media" style={`view-transition-name: ${transitionNameFor(project.slug)}`}>
      {
        project.media === 'video' ? (
          <ProjectVideo class="project__frame" slug={project.slug} label={`nagranie projektu ${project.name}`} priority />
        ) : (
          <ProjectPoster class="project__frame" slug={project.slug} alt={`zrzut ekranu strony ${project.name}, ${project.kind}`} priority />
        )
      }
    </div>

    <div class="shell project__body">
      <dl class="project__facts">
        <div class="project__fact">
          <dt>w środku</dt>
          <dd>{project.summary}</dd>
        </div>
        <div class="project__fact">
          <dt>rola</dt>
          <dd>{project.role}</dd>
        </div>
        <div class="project__fact">
          <dt>technologie</dt>
          <dd>
            <ul class="project__stack">
              {project.stack.map((technology) => <li>{technology}</li>)}
            </ul>
          </dd>
        </div>
      </dl>

      {
        project.url && (
          <p class="project__visit">
            <a class="button" href={project.url} rel="noopener">
              otwórz stronę<span class="visually-hidden"> {project.name}</span>
              <span class="button__arrow" aria-hidden="true">↗</span>
            </a>
            <span class="small project__host">{siteHost}</span>
          </p>
        )
      }
    </div>

    <nav class="shell project__next" aria-label="następny projekt">
      <a class="project__next-link" href={projectHref(nextProject.slug)}>
        <span class="hand project__next-note">następny projekt</span>
        <span class="project__next-name">
          {nextProject.name}
          <span class="button__arrow" aria-hidden="true">→</span>
        </span>
        <span class="small project__next-kind">{nextProject.kind}</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--section-gap);
  }

  .project__intro {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .project__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    margin-bottom: var(--space-2);
    font-weight: 600;
    text-decoration: none;
  }

  .project__back-arrow {
    transition: transform var(--duration-short) var(--ease-calm);
  }

  .project__note {
    color: var(--color-accent);
  }

  .project__tagline {
    color: var(--color-ink-muted);
  }

  .project__media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: 68svh;
    background: var(--color-ink);
  }

  .project__media :global(.project__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project__body {
    display: grid;
    gap: var(--space-6);
  }

  .project__facts {
    display: grid;
    margin: 0;
  }

  .project__fact {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .project__fact:last-child {
    border-bottom: var(--border-thin) solid var(--color-line);
  }

  .project__fact dt {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-body);
  }

  .project__fact dd {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--text-body-large);
    letter-spacing: var(--tracking-body);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  .project__visit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .project__host {
    color: var(--color-ink-muted);
  }

  .project__next-link {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: var(--border-thin) solid var(--color-line);
    text-decoration: none;
  }

  .project__next-note {
    color: var(--color-accent);
  }

  .project__next-name {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .project__next-kind {
    color: var(--color-ink-muted);
  }

  @media (hover: hover) {
    .project__back:hover .project__back-arrow {
      transform: translateX(-4px);
    }

    .project__next-link:hover .button__arrow {
      transform: translateX(4px);
    }
  }

  @media (min-width: 768px) {
    .project__media {
      aspect-ratio: 16 / 10;
      max-height: 80svh;
    }

    .project__fact {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--space-4);
    }

    .project__fact dt {
      padding-top: 2px;
    }
  }
</style>
