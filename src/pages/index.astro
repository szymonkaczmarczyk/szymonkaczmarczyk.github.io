---
import BaseLayout from '../layouts/BaseLayout.astro';
import StartSection from '../components/StartSection.astro';
import CinemaChapters from '../components/CinemaChapters.astro';
import { moreProjects } from '../data/projekty';
import { aboutCopy, contactCopy, owner } from '../data/strona';
---

<BaseLayout>
  <StartSection />

  <CinemaChapters />

  <section id="wiecej" class="shell page-section" aria-labelledby="wiecej-title">
    <h2 id="wiecej-title">więcej prac</h2>
    <ul class="project-rows">
      {
        moreProjects.map((project) => (
          <li class="project-row">
            <h4>{project.name}</h4>
            <p class="small">{project.tagline}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="o-mnie" class="shell page-section" aria-labelledby="o-mnie-title">
    <h2 id="o-mnie-title">{aboutCopy.heading}</h2>
    <p class="lead">{aboutCopy.text}</p>
    <p class="small">{aboutCopy.videoCaption}</p>
  </section>

  <section id="kontakt" class="shell page-section" aria-labelledby="kontakt-title">
    <h2 id="kontakt-title">{contactCopy.heading}</h2>
    <p class="lead">{contactCopy.text}</p>
    <a class="button" href={`mailto:${owner.email}`}>{contactCopy.actionLabel} <span class="button__arrow" aria-hidden="true">→</span></a>
    <ul class="contact-links">
      <li><a class="button button--quiet" href={owner.github} rel="noopener noreferrer">GitHub</a></li>
      <li><a class="button button--quiet" href={owner.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .page-section {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--section-gap) 0;
  }

  .project-rows {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .project-row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .page-section > .button {
    justify-self: start;
  }
</style>
